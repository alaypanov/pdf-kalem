{
  "name": "pdf-kalem",
  "version": "0.1.0",
  "description": "PDF-focused widget-tree UI library for document generation.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "A Laypanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaypanov/pdf-kalem.git"
  },
  "bugs": {
    "url": "https://github.com/alaypanov/pdf-kalem/issues"
  },
  "homepage": "https://github.com/alaypanov/pdf-kalem#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./utils/color-utils": {
      "types": "./dist/utils/color-utils.d.ts",
      "import": "./dist/utils/color-utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node tests/pagination.test.mjs && node tests/fonts.test.mjs && node tests/layout.test.mjs && node tests/runs.test.mjs && node tests/markdown.test.mjs && node tests/aspect-fit.test.mjs",
    "examples": "pnpm build && cd examples/basic && node main.ts && cd ../invoice && node src/main.ts && cd ../report && node src/main.ts && cd ../markdown && node src/main.ts",
    "dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pub": "pnpm publish --access public",
    "dry": "pnpm publish --dry-run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@mdi/js": "^7.4.47",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "8.1.4",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "yoga-layout": "^3.2.1"
  },
  "keywords": [
    "pdf",
    "layout",
    "document",
    "typescript",
    "pdf-lib"
  ],
  "packageManager": "pnpm@11.3.0"
}
