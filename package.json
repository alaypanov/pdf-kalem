{
  "name": "kalem",
  "version": "0.0.1",
  "description": "PDF-focused widget-tree UI library for document generation.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "A Laypanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaypanov/kalem.git"
  },
  "bugs": {
    "url": "https://github.com/alaypanov/kalem/issues"
  },
  "homepage": "https://github.com/alaypanov/kalem#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./utils/color-utils": {
      "types": "./dist/utils/color-utils.d.ts",
      "import": "./dist/utils/color-utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --open /examples/",
    "build": "tsup",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node tests/pagination.test.mjs && node tests/padding.test.mjs",
    "preview": "vite preview --open /examples/",
    "pub": "publish --access public",
    "dry": "publish --dry-run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@pdf-lib/fontkit": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "pdf-lib": "^1.17.1",
    "yoga-layout": "^3.2.1"
  },
  "keywords": [
    "pdf",
    "layout",
    "document",
    "typescript",
    "pdf-lib"
  ],
  "packageManager": "pnpm@11.3.0"
}
